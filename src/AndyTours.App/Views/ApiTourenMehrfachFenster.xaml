<Window x:Class="AndyTours.App.Views.ApiTourenMehrfachFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titel, Mode=OneWay}" Width="520" MinWidth="420" Height="390" MinHeight="300" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding Anzahl, Mode=OneWay, StringFormat='Ausgewählte Touren: {0}'}"
                   FontWeight="SemiBold" Margin="0,0,0,12" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding Beschreibung, Mode=OneWay}" TextWrapping="Wrap" />
        </ScrollViewer>
        <Border Grid.Row="2" Margin="0,12,0,8" Padding="10" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
            <StackPanel>
                <TextBlock Text="{Binding Status, Mode=OneWay}" />
                <TextBlock Text="{Binding Hinweis, Mode=OneWay}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                             Visibility="{Binding IstBeschaeftigt, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Content="Ausführen" Command="{Binding AusfuehrenCommand}" Margin="4" MinWidth="100" />
            <Button Content="Abbrechen" Command="{Binding AbbrechenCommand}" Margin="4" MinWidth="100" />
            <Button x:Name="SchliessenButton" Content="Schließen" IsCancel="True" Margin="4" MinWidth="100" />
        </WrapPanel>
    </Grid>
</Window>
