<Window x:Class="AndyTours.App.Views.ApiSicherungsarchivFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vollarchiv erstellen" Width="720" Height="520" MinWidth="520" MinHeight="380" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Language="de-DE" Background="{StaticResource ApiFlaeche}">
    <!-- Aufbau: Ergebnisdetails rollen; Erstellen und Schließen bleiben im festen Footer. -->
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Vollarchiv auf dem Server" Style="{StaticResource ApiDialogTitel}"/>
            <TextBlock Text="Das Vollarchiv enthält die Serverdatenbank, FIT-Dateien und zugehörige Anhänge. Die Größen- und Umfangsgrenzen werden serverseitig festgelegt. Dieses Fenster bietet keine Wiederherstellung, keinen Download und keine Auswahl von Serverpfaden."
                       Style="{StaticResource ApiErklaerung}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource ApiKartenrahmen}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Vorgang" Style="{StaticResource ApiAbschnittstitel}"/>
                        <TextBlock Text="{Binding VorgangsId, Mode=OneWay}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Status, Mode=OneWay}" Style="{StaticResource ApiStatus}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ApiKartenrahmen}">
                    <StackPanel>
                        <TextBlock Text="Geprüftes Vollarchiv" Style="{StaticResource ApiAbschnittstitel}"/>
                        <TextBlock Text="Archiv-ID" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Ergebnis.Id, Mode=OneWay}" TextWrapping="Wrap" Margin="0,2,0,7"/>
                        <TextBlock Text="Erstellt (UTC)" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Ergebnis.ErstelltUtc, Mode=OneWay}" Margin="0,2,0,7"/>
                        <TextBlock Text="Größe (Bytes)" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Ergebnis.Byteanzahl, Mode=OneWay}" Margin="0,2,0,7"/>
                        <TextBlock Text="SHA-256" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Ergebnis.InhaltHash, Mode=OneWay}" Style="{StaticResource ApiHashFeld}"/>
                        <TextBlock Text="Noch kein Archiv-Ergebnis vorhanden." Margin="0,8,0,0">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ApiErklaerung}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                <DataTrigger Binding="{Binding Ergebnis}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="5" Margin="0,10,0,0">
            <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IstBeschaeftigt}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
        </ProgressBar>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Command="{Binding ErstellenCommand}" Style="{StaticResource ApiPrimaeraktion}" Margin="0,0,8,0" MinWidth="250" MaxWidth="340">
                <TextBlock Text="Sicherung erstellen / Vorgang fortsetzen" TextWrapping="Wrap"/>
            </Button>
            <Button Content="Schließen" IsCancel="True" Padding="12,7" Margin="0"/>
        </WrapPanel>
    </Grid>
</Window>