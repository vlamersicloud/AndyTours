<Window x:Class="AndyTours.App.Views.ApiSicherungsarchivFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vollarchiv erstellen" Width="720" Height="520"
        MinWidth="520" MinHeight="380" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Language="de-DE">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Vollarchiv auf dem Server" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Das Vollarchiv enthält die Serverdatenbank, FIT-Dateien und zugehörige Anhänge. Die Größen- und Umfangsgrenzen werden serverseitig festgelegt. Dieses Fenster bietet keine Wiederherstellung, keinen Download und keine Auswahl von Serverpfaden."
                           TextWrapping="Wrap" Margin="0,6,0,12"/>
                <TextBlock Text="{Binding Status, Mode=OneWay}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="Vorgangs-ID" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding VorgangsId, Mode=OneWay}" TextWrapping="Wrap" Margin="0,3,0,8"/>
            </StackPanel>

            <GroupBox Grid.Row="1" Header="Geprüftes Vollarchiv" Margin="0,4,0,0">
                <StackPanel Margin="10">
                    <TextBlock Text="Archiv-ID" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Ergebnis.Id, Mode=OneWay}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                    <TextBlock Text="Erstellt (UTC)" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Ergebnis.ErstelltUtc, Mode=OneWay}" Margin="0,2,0,6"/>
                    <TextBlock Text="Größe (Bytes)" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Ergebnis.Byteanzahl, Mode=OneWay}" Margin="0,2,0,6"/>
                    <TextBlock Text="SHA-256" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Ergebnis.InhaltHash, Mode=OneWay}" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="5" Margin="0,14,0,0">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IstBeschaeftigt}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Sicherung erstellen / Vorgang fortsetzen"
                        Command="{Binding ErstellenCommand}" Padding="10,6" Margin="0,0,8,0"/>
                <Button Content="Schließen" IsCancel="True" Padding="10,6"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>