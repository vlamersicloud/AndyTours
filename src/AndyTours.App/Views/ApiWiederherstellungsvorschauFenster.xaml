<Window x:Class="AndyTours.App.Views.ApiWiederherstellungsvorschauFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wiederherstellungsvorschau" Width="900" Height="720" MinWidth="680" MinHeight="520" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Language="de-DE" Background="{StaticResource ApiFlaeche}">
    <!-- Aufbau: Katalog und Metadaten rollen; ausschließlich Lade-, Vorschau- und Schließaktionen im Footer. -->
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Nur Metadatenvorschau – keine Wiederherstellung freigegeben." Style="{StaticResource ApiDialogTitel}"/>
            <TextBlock Text="Die Vorschau prüft keine SQLite-Datenbank, extrahiert keine Dateien und wendet nichts an. Unbekannte Angaben bleiben ausdrücklich ungeprüft."
                       Style="{StaticResource ApiErklaerung}" Margin="0,0,0,7"/>
            <TextBlock Text="{Binding Status, Mode=OneWay}" Style="{StaticResource ApiStatus}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid MinHeight="120" MaxHeight="300">
                    <DataGrid Style="{StaticResource ApiTabelle}" ItemsSource="{Binding Eintraege, Mode=OneWay}"
                              SelectedItem="{Binding Auswahl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" HeadersVisibility="Column" CanUserSortColumns="True"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Art" Binding="{Binding Art}" Width="90"/>
                            <DataGridTextColumn Header="Erstellt (UTC)" Binding="{Binding ErstelltUtc, TargetNullValue=Unbekannt / ungeprüft, FallbackValue=Unbekannt / ungeprüft}" Width="150"/>
                            <DataGridTextColumn Header="Legacy-Zeitstempel (Zeitzone unbekannt)" Binding="{Binding LegacyZeitstempel, TargetNullValue=Unbekannt / ungeprüft, FallbackValue=Unbekannt / ungeprüft}" Width="2*"/>
                            <DataGridTextColumn Header="Bytes" Binding="{Binding Byteanzahl, TargetNullValue=Unbekannt / ungeprüft, FallbackValue=Unbekannt / ungeprüft}" Width="100"/>
                            <DataGridTextColumn Header="Sicherungs-ID" Binding="{Binding Id}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Background="White" Padding="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Eintraege.Count}" Value="0"/><Condition Binding="{Binding IstBeschaeftigt}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                        </Style.Triggers></Style></Border.Style>
                        <TextBlock Text="Noch keine Katalogeinträge angezeigt." Style="{StaticResource ApiErklaerung}"/>
                    </Border>
                </Grid>
                <Border Style="{StaticResource ApiKartenrahmen}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="SHA-256 der ausgewählten Datei" Style="{StaticResource ApiAbschnittstitel}"/>
                        <TextBox Text="{Binding Auswahl.InhaltHash, Mode=OneWay, TargetNullValue=Keine Auswahl, FallbackValue=Keine Auswahl}" Style="{StaticResource ApiHashFeld}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ApiKartenrahmen}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Vorschau – Metadaten, keine Freigabe" Style="{StaticResource ApiAbschnittstitel}"/>
                        <TextBlock Text="Manifestformat" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Vorschau.ManifestFormatversion, Mode=OneWay, TargetNullValue=Unbekannt / ungeprüft, FallbackValue=Unbekannt / ungeprüft}" TextWrapping="Wrap" Margin="0,2,0,7"/>
                        <TextBlock Text="Dateianzahl (Datenbank und Nutzdaten)" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Vorschau.Dateianzahl, Mode=OneWay, TargetNullValue=Unbekannt / ungeprüft, FallbackValue=Unbekannt / ungeprüft}" TextWrapping="Wrap" Margin="0,2,0,7"/>
                        <TextBlock Text="Entpackte Nutzdatenbytes" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Vorschau.NutzdatenBytes, Mode=OneWay, TargetNullValue=Unbekannt / ungeprüft, FallbackValue=Unbekannt / ungeprüft}" TextWrapping="Wrap" Margin="0,2,0,7"/>
                        <TextBlock Text="Datenbankprüfung" FontWeight="SemiBold"/>
                        <TextBlock Text="Nicht ausgeführt" Margin="0,2,0,7"/>
                        <TextBlock Text="Anwendungsfreigabe" FontWeight="SemiBold"/>
                        <TextBlock Text="Nein" Margin="0,2,0,7"/>
                        <ItemsControl ItemsSource="{Binding Vorschau.Hinweise, Mode=OneWay}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" IsIndeterminate="True" Width="90" Height="5" VerticalAlignment="Center" Margin="0,0,12,0">
                <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IstBeschaeftigt}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
            </ProgressBar>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="Katalog laden" Command="{Binding LadenCommand}" Style="{StaticResource ApiAktion}"/>
                <Button Content="Vorschau anfordern" Command="{Binding VorschauCommand}" Style="{StaticResource ApiPrimaeraktion}"/>
                <Button Content="Schließen" IsCancel="True" Padding="12,7" Margin="0"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>