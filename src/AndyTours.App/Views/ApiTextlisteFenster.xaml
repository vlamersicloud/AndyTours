<Window x:Class="AndyTours.App.Views.ApiTextlisteFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Art}" Width="700" Height="600" MinWidth="480" MinHeight="400" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource ApiFlaeche}" Language="de-DE">
    <!-- Aufbau: begrenzte Eintragsliste, scrollbarer Editorbereich und unverrückbarer Aktions-/Statusfooter. -->
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ApiAktion}">
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style x:Key="BusyInput" TargetType="Control">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Laedt}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                <DataTrigger Binding="{Binding Aendert}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Art}" Style="{StaticResource ApiDialogTitel}"/>
            <TextBlock Text="Einträge der ausgewählten Textliste verwalten." Style="{StaticResource ApiErklaerung}"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource ApiKartenrahmen}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox Grid.Row="0" ItemsSource="{Binding Eintraege}" SelectedItem="{Binding Auswahl, Mode=TwoWay}"
                         Style="{StaticResource BusyInput}" BorderBrush="{StaticResource ApiKante}" Background="White" Padding="4"/>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="Eintrag" Style="{StaticResource ApiAbschnittstitel}"/>
                    <DockPanel>
                        <TextBox Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BusyInput}"
                                 MinWidth="160" VerticalContentAlignment="Center" Padding="8,6"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" Style="{StaticResource ApiStatus}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Width="100" Height="5" IsIndeterminate="True" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                        <DataTrigger Binding="{Binding Laedt}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        <DataTrigger Binding="{Binding Aendert}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers></Style></ProgressBar.Style>
                </ProgressBar>
            </Grid>
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Laden" Command="{Binding LadenCommand}" Style="{StaticResource ActionButton}"/>
                <Button Content="Hinzufügen" Command="{Binding AnlegenCommand}" Style="{StaticResource ActionButton}"/>
                <Button Content="Umbenennen" Command="{Binding UmbenennenCommand}" Style="{StaticResource ActionButton}"/>
                <Button Content="Löschen" Command="{Binding LoeschenCommand}" Style="{StaticResource ApiDestruktiveAktion}" Margin="3"/>
                <Button Content="Nach oben" Command="{Binding NachObenCommand}" Style="{StaticResource ActionButton}"/>
                <Button Content="Nach unten" Command="{Binding NachUntenCommand}" Style="{StaticResource ActionButton}"/>
                <Button Content="Schließen" IsCancel="True" Style="{StaticResource ActionButton}" Margin="3,0,0,0"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
