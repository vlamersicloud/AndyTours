<Window x:Class="AndyTours.App.Views.BackendVerbindungFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AndyTours verbinden" Width="560" SizeToContent="Height" MinWidth="500"
        Background="#F4F6F8" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#26384D"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="8,0,0,0"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Mit einem Backend verbinden" FontSize="22" FontWeight="SemiBold" Foreground="#18324F"/>
            <TextBlock Text="Wähle, wo deine AndyTours-Daten gespeichert sind." Foreground="#637083" Margin="0,4,0,18"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton x:Name="LokalRadio" Content="Lokal auf diesem Gerät" IsChecked="True" Checked="VerbindungstypGeaendert" Margin="0,0,24,0" GroupName="Backend"/>
                <RadioButton x:Name="ZentralRadio" Content="Zentrales Backend" Checked="VerbindungstypGeaendert" GroupName="Backend"/>
            </StackPanel>
            <StackPanel x:Name="LokalBereich">
                <TextBlock Text="Datenordner" FontWeight="SemiBold"/>
                <DockPanel>
                    <Button x:Name="OrdnerWaehlenButton" DockPanel.Dock="Right" Content="Ordner wählen…" Click="OrdnerWaehlen_Click" Margin="8,4,0,12"/>
                    <TextBox x:Name="DatenordnerText" IsReadOnly="True"/>
                </DockPanel>
                <Border Background="#E8F1FB" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                    <TextBlock Text="Der Datenordner wird vom Backend geöffnet. Schemaumbauten werden vorher gesichert."
                               TextWrapping="Wrap" Foreground="#245B91" Margin="0"/>
                </Border>
            </StackPanel>
            <StackPanel x:Name="ZentralBereich" Visibility="Collapsed">
                <TextBlock Text="HTTPS-Backendadresse" FontWeight="SemiBold"/>
                <TextBox x:Name="BackendAdresseText" Text="https://" />
                <TextBlock Text="Zugriffstoken" FontWeight="SemiBold"/>
                <PasswordBox x:Name="ZugriffstokenBox"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2">
            <ProgressBar x:Name="LadeFortschritt" Height="4" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" MinHeight="20" Margin="0,8,0,4" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <DockPanel Grid.Row="3" LastChildFill="False" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="AbbrechenButton" Content="Abbrechen" IsCancel="True" Click="Abbrechen_Click"/>
            <Button x:Name="VerbindenButton" Content="Verbinden" IsDefault="True" Click="Verbinden_Click" Background="#246DB2" Foreground="White" FontWeight="SemiBold"/>
        </DockPanel>
    </Grid>
</Window>