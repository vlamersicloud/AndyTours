<Window x:Class="AndyTours.App.Views.BackendVerbindungFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AndyTours verbinden" Width="560" Height="650" MinWidth="500" MinHeight="480" ResizeMode="CanResize"
        Background="{StaticResource ApiFlaeche}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Language="de-DE">
    <!-- Aufbau: Verbindungsfelder rollen; Lade-/Fehlerstatus und Dialogaktionen bleiben fest sichtbar. -->
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Mit einem Backend verbinden" Style="{StaticResource ApiDialogTitel}"/>
            <TextBlock Text="Wähle, wo deine AndyTours-Daten gespeichert sind." Style="{StaticResource ApiErklaerung}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource ApiKartenrahmen}">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,14">
                            <RadioButton x:Name="LokalRadio" Content="Lokal auf diesem Gerät" IsChecked="True" Checked="VerbindungstypGeaendert" Margin="0,0,24,0" GroupName="Backend"/>
                            <RadioButton x:Name="ZentralRadio" Content="Zentrales Backend" Checked="VerbindungstypGeaendert" GroupName="Backend"/>
                        </WrapPanel>
                        <StackPanel x:Name="LokalBereich">
                            <TextBlock Text="Datenordner" FontWeight="SemiBold"/>
                            <DockPanel>
                                <Button x:Name="OrdnerWaehlenButton" DockPanel.Dock="Right" Content="Ordner wählen…" Click="OrdnerWaehlen_Click" Margin="8,4,0,12"/>
                                <TextBox x:Name="DatenordnerText" IsReadOnly="True" Margin="0,4,0,12" Padding="8,6"/>
                            </DockPanel>
                            <Border Background="#E8F1FB" BorderBrush="#C2C9D1" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                                <TextBlock Text="Der Datenordner wird vom Backend geöffnet. Schemaumbauten werden vorher gesichert."
                                           TextWrapping="Wrap" Foreground="#245B91" Margin="0"/>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="ZentralBereich" Visibility="Collapsed">
                            <TextBlock Text="HTTPS-Backendadresse" FontWeight="SemiBold"/>
                            <TextBox x:Name="BackendAdresseText" Text="https://" Margin="0,4,0,12" Padding="8,6"/>
                            <TextBlock Text="Zugriffstoken" FontWeight="SemiBold"/>
                            <PasswordBox x:Name="ZugriffstokenBox" Margin="0,4,0,12" Padding="8,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <ProgressBar x:Name="LadeFortschritt" Height="4" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" MinHeight="20" Margin="0,8,0,4" Style="{StaticResource ApiStatus}"/>
        </StackPanel>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AbbrechenButton" Content="Abbrechen" IsCancel="True" Click="Abbrechen_Click" Style="{StaticResource ApiAktion}"/>
            <Button x:Name="VerbindenButton" Content="Verbinden" IsDefault="True" Click="Verbinden_Click" Style="{StaticResource ApiPrimaeraktion}" Margin="0"/>
        </WrapPanel>
    </Grid>
</Window>