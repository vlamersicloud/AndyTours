<Window x:Class="AndyTours.App.Views.ApiAktivitaetenFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aktivitäten verwalten · AndyTours" Width="900" Height="650" MinWidth="560" MinHeight="400"
        Language="de-DE" Background="{StaticResource ApiFlaeche}" WindowStartupLocation="CenterOwner">
    <!-- Aufbau: feste Überschrift und Statusleiste; Tabelle bleibt im begrenzten Grid virtualisiert. -->
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Laedt}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="Neu laden" Command="{Binding LadenCommand}" Padding="12,6"/>
                <StackPanel>
                    <TextBlock Text="Aktivitäten verwalten" Style="{StaticResource ApiDialogTitel}"/>
                    <TextBlock Text="Änderungen verwenden die geladene Familienversion; bei Konflikten bitte neu laden."
                               Foreground="#637083" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
            <DataGrid Grid.Row="1" Style="{StaticResource ApiTabelle}" Margin="0,0,0,14"
                      ItemsSource="{Binding Eintraege}" SelectedItem="{Binding Auswahl, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                      SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                    <DataGridCheckBoxColumn Header="Haupt" Binding="{Binding IstHaupt}" Width="Auto"/>
                    <DataGridTextColumn Header="Einheit" Binding="{Binding Geschwindigkeitseinheit}" Width="*"/>
                    <DataGridTextColumn Header="Ziel km" Binding="{Binding ZielKm, StringFormat={}{0:N1}}" Width="*"/>
                    <DataGridTextColumn Header="Ziel hm" Binding="{Binding ZielHm, StringFormat={}{0:N0}}" Width="*"/>
                    <DataGridTextColumn Header="Ziel Anzahl" Binding="{Binding ZielAnzahl}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>


        </Grid>
        <Border Grid.Row="1" Style="{StaticResource ApiKartenrahmen}" Margin="0,10,0,0" Padding="10">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <ProgressBar Height="3" IsIndeterminate="{Binding Laedt}"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource ApiStatus}" Margin="0,6,0,0"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <Expander Grid.Row="1" Header="Editor und Aktionen" IsExpanded="False">
                    <ScrollViewer Height="104" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding Laedt}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <TextBlock Text="Aktivitätsname" Style="{StaticResource ApiAbschnittstitel}"/>
                            <WrapPanel>
                                <StackPanel Width="230" Margin="0,0,12,8">
                                    <TextBlock Text="Aktivitätsname" Foreground="#637083"/>
                                    <TextBox Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Width="230" Margin="0,0,12,8">
                                    <TextBlock Text="Zusammenführen in" Foreground="#637083"/>
                                    <ComboBox ItemsSource="{Binding ZielOptionen}" SelectedItem="{Binding Ziel, Mode=TwoWay}"
                                              DisplayMemberPath="Name" Margin="0,5,0,0"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="Verwalten" Style="{StaticResource ApiAbschnittstitel}"/>
                            <WrapPanel>
                                <Button Content="Anlegen" Command="{Binding AnlegenCommand}" Style="{StaticResource ApiAktion}"/>
                                <Button Content="Umbenennen" Command="{Binding UmbenennenCommand}" Style="{StaticResource ApiAktion}"/>
                                <Button Content="Löschen" Command="{Binding LoeschenCommand}" Style="{StaticResource ApiDestruktiveAktion}"/>
                                <Button Content="Als Haupt setzen" Command="{Binding HauptSetzenCommand}" Style="{StaticResource ApiAktion}"/>
                            </WrapPanel>
                            <TextBlock Text="Reihenfolge" Style="{StaticResource ApiAbschnittstitel}" Margin="0,8,0,4"/>
                            <WrapPanel>
                                <Button Content="Nach oben" Command="{Binding NachObenCommand}" Style="{StaticResource ApiAktion}"/>
                                <Button Content="Nach unten" Command="{Binding NachUntenCommand}" Style="{StaticResource ApiAktion}"/>
                                <Button Content="Zusammenführen" Command="{Binding ZusammenfuehrenCommand}" Style="{StaticResource ApiPrimaeraktion}"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
                <WrapPanel Grid.Row="2" HorizontalAlignment="Right"><Button Content="Schließen" IsCancel="True" Style="{StaticResource ApiAktion}" Margin="0"/></WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>