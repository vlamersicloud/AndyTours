<!--
  Allgemeines Fortschrittsfenster für länger dauernde Kopiervorgänge.

  Aufbau von oben nach unten:
    1. Fortschrittsbalken (0–100 %)
    2. „Dateien: x von y“
    3. „Datenmenge: x von y MB“

  Das Fenster wird modal angezeigt: Solange es offen ist, sind alle anderen Fenster der App
  gesperrt. Schließen ist erst nach dem Ende des Kopierens möglich (siehe Code-Behind).
-->
<Window x:Class="AndyTours.App.Views.FortschrittsFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titel}"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="16">

        <!-- 1. Balken -->
        <ProgressBar Height="20" Minimum="0" Maximum="100" Value="{Binding Prozent, Mode=OneWay}" Margin="0,0,0,12" />

        <!-- 2. Anzahl Dateien -->
        <TextBlock Text="{Binding DateienText}" Margin="0,0,0,4" />

        <!-- 3. Datenmenge -->
        <TextBlock Text="{Binding MengeText}" />
        <Button Content="_Abbrechen" Command="{Binding AbbrechenCommand}"
                HorizontalAlignment="Right" MinWidth="100" Padding="8,3" Margin="0,12,0,0">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IstAbbrechbar}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

    </StackPanel>
</Window>
