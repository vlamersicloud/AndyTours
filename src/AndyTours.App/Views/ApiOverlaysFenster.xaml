<Window x:Class="AndyTours.App.Views.ApiOverlaysFenster"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AndyTours.App.ViewModels"
 Title="Overlays" Width="680" Height="720" MinWidth="400" MinHeight="420"
 WindowStartupLocation="CenterOwner" Loaded="FensterGeladen" Closing="FensterSchliesst" Closed="FensterGeschlossen">
 <DockPanel Margin="10">
  <StackPanel DockPanel.Dock="Top">
   <WrapPanel>
    <Button Content="Laden" Command="{Binding LadenCommand}" Margin="2"/>
    <Button Content="Ordner anlegen" Command="{Binding OrdnerAnlegenCommand}" Margin="2"/>
    <Button Content="Verschieben…" Command="{Binding VerschiebenCommand}" Margin="2"/>
    <Button Content="Löschen" Command="{Binding LoeschenCommand}" Margin="2"/>
    <Button Content="GPX-Dateien wählen…" Command="{Binding GpxHinzufuegenCommand}" Margin="2"/>
    <Button Content="Importieren" Command="{Binding GpxImportierenCommand}" Margin="2"/>
    <Button Content="Auswahl verwerfen" Command="{Binding GpxAuswahlVerwerfenCommand}" Margin="2"/>
   </WrapPanel>
   <TextBlock Text="{Binding Hinweis}" TextWrapping="Wrap" Margin="2,8"/>
   <DataGrid ItemsSource="{Binding Importdateien}" Height="120" IsReadOnly="True"
             EnableRowVirtualization="True" EnableColumnVirtualization="True"
             AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
             HeadersVisibility="Column" ScrollViewer.CanContentScroll="True">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Datei" Binding="{Binding Dateiname, Mode=OneWay}" Width="2*"/>
     <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="3*"/>
    </DataGrid.Columns>
   </DataGrid>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <DockPanel><Button DockPanel.Dock="Right" Content="Übernehmen" Command="{Binding NameUebernehmenCommand}"/>
    <TextBox x:Name="NamensFeld" Text="{Binding Bearbeitungsname, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding KannAuswahlAendern}" />
   </DockPanel>
   <WrapPanel Margin="0,5"><TextBlock Text="Farbe:" VerticalAlignment="Center"/>
    <ComboBox ItemsSource="{Binding Farbauswahl}" SelectedItem="{Binding GewaehlteFarbe}" IsEnabled="{Binding KannOverlayAendern}" DisplayMemberPath="Name" Width="180" Margin="4,0"/>
    <TextBlock Text="Gemeinsam:" VerticalAlignment="Center"/>
    <ComboBox ItemsSource="{Binding GemeinsameFarbauswahl}" SelectedItem="{Binding GewaehlteGemeinsameFarbe}" DisplayMemberPath="Name" Width="180" Margin="4,0" IsEnabled="{Binding KannAendern}"/>
   </WrapPanel>
  </StackPanel>
  <TreeView ItemsSource="{Binding Wurzeln}" Height="260" VerticalAlignment="Stretch" IsEnabled="{Binding IstBereit}" MouseDoubleClick="BaumDoppelklick" PreviewMouseRightButtonDown="BaumRechtsklick">
   <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsSelected" Value="{Binding IstAusgewaehlt, Mode=TwoWay}"/><Setter Property="IsExpanded" Value="{Binding IstAufgeklappt, Mode=TwoWay}"/></Style></TreeView.ItemContainerStyle>
   <TreeView.Resources><HierarchicalDataTemplate DataType="{x:Type local:ApiOverlayknoten}" ItemsSource="{Binding Kinder}"><StackPanel Orientation="Horizontal"><CheckBox IsThreeState="True" IsChecked="{Binding IstEingeschaltet, Mode=TwoWay}"/><TextBlock Text="{Binding Name}" Margin="5,0"/><TextBlock Text="{Binding Farbe}" Foreground="{Binding Farbe}" Margin="4,0"/></StackPanel></HierarchicalDataTemplate>
   </TreeView.Resources>
  </TreeView>
 </DockPanel>
</Window>