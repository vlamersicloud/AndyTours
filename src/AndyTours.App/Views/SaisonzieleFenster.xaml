<!--
  Fenster „Saisonziele“ (Menü „Extras → Saisonziele…“).

  Aufbau von oben nach unten:
    1. Jahresauswahl: laufendes und folgendes Jahr (gesperrt, solange eine Eingabe ungültig ist)
    2. Tabelle: je Aktivität eine Zeile mit Kilometer, Höhenmeter, Anzahl und Herkunft
       („übernommen aus 2026“ bzw. „Grundziel“; leer bei einem eigenen Ziel)
    3. Roter Hinweis bei ungültiger Eingabe (nennt Aktivität, Feld und erlaubten Bereich)
    4. „OK“ (nur bei gültigen Eingaben) und „Abbrechen“

  Datenquelle ist das SaisonzieleViewModel. Ein leeres Feld bedeutet „kein Ziel“. „OK“ speichert beide
  Jahre; „Abbrechen“ (auch Esc) schließt ohne Rückfrage und ändert nichts.
-->
<Window x:Class="AndyTours.App.Views.SaisonzieleFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saisonziele"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Language="de-DE"
        Background="{StaticResource ApiFlaeche}">
    <Window.Resources><BooleanToVisibilityConverter x:Key="SichtbarWennWahr" /></Window.Resources>

    <!-- Reicht die Höhe des Bildschirms nicht (große Oberfläche), rollt der Inhalt;
         die Schaltflächen bleiben unten immer sichtbar -->
    <DockPanel>
        <!-- 4. Schaltflächen -->
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="16,12">
            <Button Content="_OK" IsDefault="True" MinWidth="90" Style="{StaticResource ApiPrimaeraktion}" Margin="0,0,8,0" Command="{Binding OkCommand}" />
            <Button Content="Abbrechen" IsCancel="True" MinWidth="90" Padding="8,3"><Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding Speichert}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        </WrapPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <TextBlock Text="Saisonziele" Style="{StaticResource ApiDialogTitel}" />
                <!-- 1. Jahresauswahl -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="_Jahr:" Target="{Binding ElementName=JahrFeld}" VerticalAlignment="Center" />
<ComboBox x:Name="JahrFeld" Width="90" ItemsSource="{Binding Jahre}" SelectedItem="{Binding GewaehltesJahr}" IsEnabled="{Binding IstGueltig}" />
                    <TextBlock Text="Ein Ziel gilt auch für die folgenden Jahre, bis es dort geändert wird. Leer = kein Ziel."
                               Foreground="Gray" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" Width="400" />
                </StackPanel>

                <!-- 2. Ziele je Aktivität -->
                <Border Style="{StaticResource ApiKartenrahmen}" Margin="0,10,0,0">
                <DataGrid x:Name="Tabelle" ItemsSource="{Binding Zeilen}" Margin="0,10,0,0" MaxHeight="360"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserSortColumns="False" CanUserResizeRows="False"
                          HeadersVisibility="Column" SelectionUnit="Cell" SelectionMode="Single"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FFE0E0E0">
                    <DataGrid.Style><Style TargetType="DataGrid"><Style.Triggers><DataTrigger Binding="{Binding Speichert}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Aktivität" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Kilometer" Width="90"
                                            Binding="{Binding Km, UpdateSourceTrigger=PropertyChanged}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Höhenmeter" Width="110"
                                            Binding="{Binding Hm, UpdateSourceTrigger=PropertyChanged}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Anzahl" Width="70"
                                            Binding="{Binding Anzahl, UpdateSourceTrigger=PropertyChanged}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Herkunft" Binding="{Binding Herkunft}" IsReadOnly="True" Width="190">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="Gray" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Border>

                <!-- 3. Hinweis -->
                <TextBlock Text="{Binding Hinweis}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="Speichert …" Visibility="{Binding Speichert, Converter={StaticResource SichtbarWennWahr}}" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
