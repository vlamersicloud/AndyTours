<Window x:Class="AndyTours.App.Views.ApiEquipmentEinsatzFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equipment-Einsatz" Width="900" Height="600" MinWidth="600" MinHeight="360"
        Language="de-DE" Background="#F4F6F8" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstSumme}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Equipment-Einsatz" FontSize="23" FontWeight="Bold" Foreground="#18324F"/>
            <TextBlock Text="Alle Touren – unabhängig von den Filtern der Übersicht." Margin="0,4,0,0" Foreground="#637083" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <DataGrid x:Name="EinsatzDataGrid" ItemsSource="{Binding Zeilen}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Sorting="EinsatzDataGrid_Sorting"
                      Visibility="{Binding HatZeilen, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Equipment" Binding="{Binding Name, Mode=OneWay}" SortMemberPath="Name" Width="2*"/>
                    <DataGridTextColumn Header="Vorher (km)" Binding="{Binding VorherKm, Mode=OneWay, StringFormat={}{0:N0}}" SortMemberPath="VorherKm" Width="*">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Gesamt (km)" Binding="{Binding GesamtKm, Mode=OneWay, StringFormat={}{0:N0}}" SortMemberPath="GesamtKm" Width="*">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Gesamt (hm)" Binding="{Binding GesamtHm, Mode=OneWay, StringFormat={}{0:N0}}" SortMemberPath="GesamtHm" Width="*">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}"/></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Keine Equipment-Einsatzdaten vorhanden." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#637083" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding HatZeilen}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <Button Grid.Row="2" Content="Schließen" IsCancel="True" HorizontalAlignment="Right" Padding="14,7" Margin="0,12,0,0"/>
    </Grid>
</Window>
