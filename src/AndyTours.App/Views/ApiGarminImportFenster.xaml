<Window x:Class="AndyTours.App.Views.ApiGarminImportFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AndyTours.App.Views"
        Title="Garmin-Importstatus" Width="900" Height="620" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Language="de-DE">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <local:GarminKandidatStatusConverter x:Key="CandidateStatusConverter"/>
        <local:DauerConverter x:Key="DurationConverter"/>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Garmin-Download" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Der Auftrag wird serverseitig verarbeitet und läuft auch nach dem Schließen dieses Fensters weiter."
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Padding="12" Margin="0,14,0,10" Background="#F3F6F8" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Auftrag.JobId, StringFormat=Auftrags-ID: {0}}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Auftrag.Paketnummer, StringFormat=Paket: {0}}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding WarnungenText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Auftrag.Bearbeitet, StringFormat=Bearbeitet: {0}}"/>
                    <TextBlock Text="{Binding Auftrag.Bereit, StringFormat=Prüfbereit: {0}}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding Auftrag.Importiert, StringFormat=Importiert: {0}}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding Gesamt, StringFormat=Kandidaten gesamt: {0}}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock Grid.Row="2" Text="Prüfung und Übernahme in Touren sind noch nicht angebunden." Foreground="#8A3B12" Margin="0,0,0,8"/>
        <DataGrid Grid.Row="3" ItemsSource="{Binding Kandidaten}" IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True"
                  ScrollViewer.VerticalScrollBarVisibility="Auto" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=d}" Width="110"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Distanz (km)" Binding="{Binding DistanzKm, StringFormat=F1}" Width="120"/>
                <DataGridTextColumn Header="Fahrzeit" Binding="{Binding FahrzeitSekunden, Converter={StaticResource DurationConverter}}" Width="120"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource CandidateStatusConverter}}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Width="90" Height="4" IsIndeterminate="{Binding Laedt}" Visibility="{Binding Laedt, Converter={StaticResource VisibleWhenTrue}}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="Starten" Command="{Binding StartenCommand}" Padding="10,5" Margin="0,0,6,6"/>
                <Button Content="Aktualisieren" Command="{Binding LadenAktuellenCommand}" Padding="10,5" Margin="0,0,6,6"/>
                <Button Content="Fortsetzen" Command="{Binding FortsetzenCommand}" Padding="10,5" Margin="0,0,6,6"/>
                <Button Content="Abbrechen" Command="{Binding AbbrechenCommand}" Padding="10,5" Margin="0,0,6,6"/>
                <Button Content="Vorige" Command="{Binding VorigeSeiteCommand}" Padding="10,5" Margin="0,0,6,6"/>
                <Button Content="Nächste" Command="{Binding NaechsteSeiteCommand}" Padding="10,5" Margin="0,0,0,6"/>
            </WrapPanel>
        </Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers><DataTrigger Binding="{Binding Aendert}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
            </Style>
        </Grid.Style>
    </Grid>
</Window>
