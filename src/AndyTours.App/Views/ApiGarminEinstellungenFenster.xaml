<Window x:Class="AndyTours.App.Views.ApiGarminEinstellungenFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Garmin-Einstellungen" Width="620" Height="620" MinWidth="460" MinHeight="380" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Language="de-DE" Background="{StaticResource ApiFlaeche}">
    <!-- Aufbau: sensible Schlüssel- und Automatikfelder rollen; Laden, Status und Schließen bleiben fest. -->
    <Window.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue" /></Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Garmin-Einstellungen" Style="{StaticResource ApiDialogTitel}"/>
            <TextBlock Text="Schlüsselstatus wird ausschließlich als vorhanden oder nicht vorhanden angezeigt." Style="{StaticResource ApiErklaerung}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource ApiKartenrahmen}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Garmin Personal API-Schlüssel" Style="{StaticResource ApiAbschnittstitel}"/>
                        <TextBlock Margin="0,5,0,8">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Kein Schlüssel hinterlegt"/><Style.Triggers><DataTrigger Binding="{Binding HasKey}" Value="True"><Setter Property="Text" Value="Schlüssel hinterlegt"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <PasswordBox x:Name="SchluesselFeld" PasswordChanged="SchluesselFeld_PasswordChanged"
                                     IsEnabled="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Window}}"/>

                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ApiKartenrahmen}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Automatischer Abruf" Style="{StaticResource ApiAbschnittstitel}"/>
                        <CheckBox IsChecked="{Binding AutoDraft, Mode=TwoWay}">
                            <TextBlock Text="Alle Garmin-Pakete automatisch laden" TextWrapping="Wrap"/>
                        </CheckBox>

                    </StackPanel>
                </Border>
                <Border Background="#FFFFF7E8" BorderBrush="{StaticResource ApiKante}" BorderThickness="1" CornerRadius="4" Padding="12">
                    <TextBlock Text="Automatischer Abruf verwendet 20-Aktivitäten-Pakete. Der Schlüssel liegt unverschlüsselt in der SQLite-Datenbank des Backends und in deren Sicherungen. Im zentralen Modus wird er auf dem SERVER gespeichert, nicht auf dem Windows-Client."
                               TextWrapping="Wrap" Foreground="#FF8A3B12"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" Style="{StaticResource ApiStatus}" TextWrapping="Wrap" Margin="0,0,10,8"/>
                <ProgressBar Grid.Column="1" Width="90" Height="5" IsIndeterminate="{Binding Laedt}" Visibility="{Binding Laedt, Converter={StaticResource VisibleWhenTrue}}" VerticalAlignment="Center"/>
            </Grid>
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                <Button Content="Schlüssel speichern" Command="{Binding SchluesselSpeichernCommand}" Style="{StaticResource ApiPrimaeraktion}"/>
                <Button Content="Schlüssel entfernen" Command="{Binding SchluesselEntfernenCommand}" Style="{StaticResource ApiDestruktiveAktion}"/>
                <Button Content="Automatik speichern" Command="{Binding AutomatikSpeichernCommand}" Style="{StaticResource ApiAktion}"/>
                <Button Content="Neu laden" Command="{Binding LadenCommand}" Style="{StaticResource ApiAktion}"/>
                <Button Content="Schließen" IsCancel="True" Style="{StaticResource ApiAktion}" Margin="0"/>
            </WrapPanel>
        </Grid>
        <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding Laedt}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger><DataTrigger Binding="{Binding Aendert}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Grid.Style>
    </Grid>
</Window>
