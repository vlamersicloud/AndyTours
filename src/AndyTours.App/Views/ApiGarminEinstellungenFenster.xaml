<Window x:Class="AndyTours.App.Views.ApiGarminEinstellungenFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Garmin-Einstellungen" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Language="de-DE">
    <Window.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue" /></Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Garmin Personal API-Schlüssel" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Schlüsselstatus: wird ausschließlich als vorhanden/nicht vorhanden angezeigt." TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock Margin="0,5,0,8">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Kein Schlüssel hinterlegt"/><Style.Triggers><DataTrigger Binding="{Binding HasKey}" Value="True"><Setter Property="Text" Value="Schlüssel hinterlegt"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <PasswordBox x:Name="SchluesselFeld" PasswordChanged="SchluesselFeld_PasswordChanged" IsEnabled="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Schlüssel speichern" Command="{Binding SchluesselSpeichernCommand}" Padding="10,5" Margin="0,0,8,0" />
                <Button Content="Schlüssel entfernen" Command="{Binding SchluesselEntfernenCommand}" Padding="10,5" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <CheckBox Content="Alle Garmin-Pakete automatisch laden" IsChecked="{Binding AutoDraft, Mode=TwoWay}" />
            <Button Content="Automatik speichern" Command="{Binding AutomatikSpeichernCommand}" HorizontalAlignment="Left" Padding="10,5" Margin="0,8,0,0" />
        </StackPanel>
        <TextBlock Grid.Row="2" Text="Automatischer Abruf verwendet 20-Aktivitäten-Pakete. Der Schlüssel liegt unverschlüsselt in der SQLite-Datenbank des Backends und in deren Sicherungen. Im zentralen Modus wird er auf dem SERVER gespeichert, nicht auf dem Windows-Client." TextWrapping="Wrap" Margin="0,18,0,0" Foreground="#8A3B12" />
        <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ProgressBar Width="90" Height="4" IsIndeterminate="{Binding Laedt}" Visibility="{Binding Laedt, Converter={StaticResource VisibleWhenTrue}}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="Neu laden" Command="{Binding LadenCommand}" Padding="10,5" Margin="0,0,8,0" />
            <Button Content="Schließen" IsCancel="True" Padding="10,5" />
        </StackPanel>
        <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding Laedt}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger><DataTrigger Binding="{Binding Aendert}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Grid.Style>
    </Grid>
</Window>
