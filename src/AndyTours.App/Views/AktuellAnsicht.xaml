<!-- Aktuelle Auswertung: ausdrückliche Datumsgrenzen für Rekorde, Kalenderbalken und FIT-Pulsbereiche.
     Zeitraster und Kennzahl werden über sichtbare Felder gewählt; kein versteckter Klick-Wechsel.
     Garmin-Pulszonen sind aktuelle, mit Abrufdatum gekennzeichnete Referenzprofile. -->
<UserControl x:Class="AndyTours.App.Views.AktuellAnsicht"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="SichtbarWennWahr" />

        <!-- Eine Zeile der Bestleistungen; Spaltenbreiten innerhalb einer Liste gleich (SharedSizeGroup) -->
        <DataTemplate x:Key="Bestleistungszeile">
            <Grid Margin="0,1" Background="Transparent">
                <!-- Doppelklick öffnet die Einheit; bei Jahresrekorden ist die Nummer leer und es passiert nichts -->
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding EinheitId}"
                                  Command="{Binding DataContext.EinheitOeffnenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid.InputBindings>
                <Grid.Resources>
                    <!-- Rekord aus dem laufenden Jahr: fett in der Linienfarbe des Diagramms -->
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IstLaufendesJahr}" Value="True">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="#FF2E6DB4" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Bezeichnung" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Wert" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Bezeichnung, StringFormat='{}{0}:'}" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding Wert}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                <TextBlock Grid.Column="2" Text="{Binding Herkunft}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Reicht der Platz nicht (große Oberfläche, kleines Fenster), rollt die Ansicht. Ist mehr Platz da, füllt das
         Diagramm den Rest wie bisher, weil der ScrollViewer seinen Inhalt mindestens so groß wie den sichtbaren
         Bereich anordnet -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="False">
        <DockPanel Margin="12">

            <StackPanel DockPanel.Dock="Top" DataContext="{Binding Jahresfortschritt}" Margin="0,0,0,12">
                <TextBlock Text="Aktivitätsübersicht" FontSize="20" FontWeight="SemiBold" />
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="Von:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <DatePicker SelectedDate="{Binding VonDatum}" Language="de-DE" Width="135" Margin="0,0,12,4" />
                    <TextBlock Text="Bis:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <DatePicker SelectedDate="{Binding BisDatum}" Language="de-DE" Width="135" Margin="0,0,12,4" />
                    <Button Content="Aktuelles Jahr bis heute" Command="{Binding AktuellesJahrCommand}" Padding="8,3" Margin="0,0,12,4" />
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="Gruppierung:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{Binding Raster}" DisplayMemberPath="Value" SelectedValuePath="Key"
                              SelectedValue="{Binding Gruppierung}" Width="180" Margin="0,0,12,4" />
                    <TextBlock Text="Kennzahl:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{Binding Werte}" DisplayMemberPath="Value" SelectedValuePath="Key"
                              SelectedValue="{Binding Wert}" Width="180" Margin="0,0,12,4" />
                </WrapPanel>
                <TextBlock Text="{Binding ZeitraumHinweis}" TextWrapping="Wrap" Foreground="DarkOrange" />
            </StackPanel>

            <!-- 1. Bestleistungen -->
            <Grid DockPanel.Dock="Top" DataContext="{Binding Bestleistungen}" Margin="0,0,0,12"
                  Visibility="{Binding HatEinheiten, Converter={StaticResource SichtbarWennWahr}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,40,0">
                    <TextBlock Text="Jahresrekorde im Zeitraum" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Jahresrekorde}" ItemTemplate="{StaticResource Bestleistungszeile}"
                                  Grid.IsSharedSizeScope="True" Focusable="False" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Einzelrekorde im Zeitraum" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Einzelrekorde}" ItemTemplate="{StaticResource Bestleistungszeile}"
                                  Grid.IsSharedSizeScope="True" Focusable="False">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="ToolTip" Value="Doppelklick öffnet die Einheit" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- 2. bis 4.: Jahresfortschritt -->
            <DockPanel DataContext="{Binding Jahresfortschritt}">

                <!-- 2. Überschrift -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding Ueberschrift}" FontSize="18" FontWeight="SemiBold" />

                <!-- 3. Kennzahlen des laufenden Jahres -->
                <StackPanel DockPanel.Dock="Top" Margin="0,6,0,8">
                    <TextBlock Text="{Binding Stand}" FontSize="14" />
                    <TextBlock Text="{Binding Ausblick}" FontSize="13" Foreground="DimGray" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Mindesthöhe, damit das Diagramm bei großer Oberfläche nicht verschwindet; darunter rollt die Ansicht -->
                <Grid DockPanel.Dock="Top" Height="300" Margin="0,0,0,16">
                    <!-- Hinweis bei leerer Auswahl -->
                    <TextBlock Text="Keine Einheiten in dieser Auswahl." HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="16" Foreground="Gray">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HatEinheiten}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 4. Diagramm; ein Klick schaltet den Wert weiter -->
                    <oxy:PlotView x:Name="Diagramm" Model="{Binding Diagramm}"
                                  Visibility="{Binding HatEinheiten, Converter={StaticResource SichtbarWennWahr}}" />
                </Grid>
                <StackPanel>
                    <TextBlock Text="Pulsbereiche und Garmin-Zonen" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Content="Garmin-Zonen aktualisieren" Command="{Binding GarminZonenAktualisierenCommand}" Padding="8,3" Margin="0,0,12,6" />
                        <ComboBox ItemsSource="{Binding Pulsprofile}" SelectedItem="{Binding Pulsprofil}" DisplayMemberPath="Anzeige" Width="210" Margin="0,0,12,6" />
                        <CheckBox Content="10-bpm-Bereiche statt Garmin-Zonen" IsChecked="{Binding BpmBereiche}" VerticalAlignment="Center" Margin="0,0,12,6" />
                        <Button Content="Pulsanalyse laden" Command="{Binding PulsdatenLadenCommand}" Padding="8,3" Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock Text="{Binding PulsReferenz}" Foreground="DimGray" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding PulsStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <oxy:PlotView Model="{Binding PulsDiagramm}" Height="320" />
                    <DataGrid ItemsSource="{Binding Pulszeilen}" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" MaxHeight="280" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zeitraum" Binding="{Binding Zeitraum}" Width="*" />
                            <DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="*" />
                            <DataGridTextColumn Header="Pulsbereich (bpm)" Binding="{Binding Pulsbereich}" Width="*" />
                            <DataGridTextColumn Header="Messzeit" Binding="{Binding Dauer}" Width="*" />
                            <DataGridTextColumn Header="Anteil Messzeit der Periode" Binding="{Binding Anteil}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </DockPanel>
        </DockPanel>
    </ScrollViewer>
</UserControl>
