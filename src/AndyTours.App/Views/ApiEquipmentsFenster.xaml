<Window x:Class="AndyTours.App.Views.ApiEquipmentsFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AndyTours.App.Views"
        Title="Equipment verwalten · AndyTours" Width="900" Height="650" MinWidth="600" MinHeight="420"
        Language="de-DE" Background="{StaticResource ApiFlaeche}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:EquipmentAktivitaetConverter x:Key="EquipmentAktivitaetConverter"/>
    </Window.Resources>
    <!-- Aufbau: feste Überschrift und Statusleiste; Tabelle bleibt im begrenzten Grid virtualisiert. -->
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Laedt}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="Neu laden" Command="{Binding LadenCommand}" Padding="12,6"/>
                <StackPanel>
                    <TextBlock Text="Equipment verwalten" Style="{StaticResource ApiDialogTitel}"/>
                    <TextBlock Text="Änderungen verwenden die geladene Familienversion; bei Konflikten bitte neu laden."
                               Foreground="#637083" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
            <DataGrid Grid.Row="1" Style="{StaticResource ApiTabelle}" Margin="0,0,0,14"
                      ItemsSource="{Binding Eintraege}" SelectedItem="{Binding Auswahl, Mode=TwoWay}" MouseDoubleClick="Grid_MouseDoubleClick" PreviewKeyDown="Grid_PreviewKeyDown"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                      SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTemplateColumn Header="Aktivität" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource EquipmentAktivitaetConverter}"><Binding Path="AktivitaetId"/><Binding Path="DataContext.AktivitaetsNamen" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="Kategorie" Binding="{Binding StandardKategorie}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Standard" Binding="{Binding IstStandard}" Width="Auto"/>
                    <DataGridCheckBoxColumn Header="Ausgemustert" Binding="{Binding Ausgemustert}" Width="Auto"/>
                    <DataGridTextColumn Header="Anschaffung" Binding="{Binding Anschaffungsdatum, StringFormat={}{0:dd.MM.yyyy}}" Width="*"/>
                    <DataGridTextColumn Header="Anfang km" Binding="{Binding AnfangsdistanzKm, StringFormat={}{0:N1}}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>


        </Grid>
        <Border Grid.Row="1" Style="{StaticResource ApiKartenrahmen}" Margin="0,10,0,0" Padding="10">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <ProgressBar Height="3" IsIndeterminate="{Binding Laedt}"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource ApiStatus}" Margin="0,6,0,0"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding Laedt}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style>
                    </WrapPanel.Style>
                    <Button Content="Neu" Command="{Binding NeuCommand}" Style="{StaticResource ApiAktion}"/>
                    <Button Content="Bearbeiten" Command="{Binding BearbeitenCommand}" Style="{StaticResource ApiAktion}"/>
                    <Button Content="Löschen" Command="{Binding LoeschenCommand}" Style="{StaticResource ApiDestruktiveAktion}"/>
                </WrapPanel>
                <WrapPanel Grid.Row="2" HorizontalAlignment="Right"><Button Content="Schließen" IsCancel="True" Style="{StaticResource ApiAktion}" Margin="0"/></WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>