<Window x:Class="AndyTours.App.Views.ApiHauptfenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:local="clr-namespace:AndyTours.App.Views"
        Title="AndyTours · API-Übersicht" Width="1200" Height="820" MinWidth="900" MinHeight="620"
        Language="de-DE" Background="#F4F6F8" WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding AktualisierenCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <local:DauerConverter x:Key="DauerConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="TourNumber" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style x:Key="FilterRangeError" TargetType="TextBox">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TourBestDistance" TargetType="TextBlock" BasedOn="{StaticResource TourNumber}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Anzeige.IstBestDistanz}" Value="True"><Setter Property="Foreground" Value="Red"/></DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Anzeige.IstBestDistanz}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#FFFFC8C8"/><Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TourBestHeight" TargetType="TextBlock" BasedOn="{StaticResource TourNumber}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Anzeige.IstBestHoehenmeter}" Value="True"><Setter Property="Foreground" Value="Red"/></DataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Anzeige.IstBestHoehenmeter}" Value="True"/><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Foreground" Value="#FFFFC8C8"/><Setter Property="FontWeight" Value="SemiBold"/></MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TourBestDuration" TargetType="TextBlock" BasedOn="{StaticResource TourNumber}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Anzeige.IstBestFahrzeit}" Value="True"><Setter Property="Foreground" Value="Red"/></DataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Anzeige.IstBestFahrzeit}" Value="True"/><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Foreground" Value="#FFFFC8C8"/><Setter Property="FontWeight" Value="SemiBold"/></MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TourBestAverageSpeed" TargetType="TextBlock" BasedOn="{StaticResource TourNumber}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Anzeige.IstBestDurchschnittKmh}" Value="True"><Setter Property="Foreground" Value="Red"/></DataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Anzeige.IstBestDurchschnittKmh}" Value="True"/><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Foreground" Value="#FFFFC8C8"/><Setter Property="FontWeight" Value="SemiBold"/></MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TourBestMaxSpeed" TargetType="TextBlock" BasedOn="{StaticResource TourNumber}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Anzeige.IstBestMaxKmh}" Value="True"><Setter Property="Foreground" Value="Red"/></DataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Anzeige.IstBestMaxKmh}" Value="True"/><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Foreground" Value="#FFFFC8C8"/><Setter Property="FontWeight" Value="SemiBold"/></MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="BackendAdresseText" VerticalAlignment="Center" Foreground="#637083" Margin="0,0,14,0"/>
                <Menu VerticalAlignment="Center" Background="Transparent">
                    <MenuItem Header="Datei" Padding="10,6">
                        <MenuItem Header="Tour planen…" Click="TourPlanen_Click"/>
                        <MenuItem Header="Routing-Einstellungen…" Click="RoutingKonfiguration_Click"/>
                        <MenuItem Header="Overlays…" Click="OverlaysOeffnen_Click"/>
                        <MenuItem Header="FIT-Dateien importieren…" Click="FitDateienImportieren_Click"/>
                        <MenuItem Header="Vom Garmin-Gerät importieren…" Click="GarminGeraetImportieren_Click"/>
                    </MenuItem>
                    <MenuItem Header="Extras" Padding="10,6">
                        <MenuItem Header="Equipment-Einsatz…" Click="EquipmentEinsatz_Click"/>
                    </MenuItem>
                    <MenuItem Header="Stammdaten" Padding="10,6">
                        <MenuItem Header="Aktivitäten…" Click="AktivitaetenVerwalten_Click"/>
                        <MenuItem Header="Kategorien…" Click="KategorienVerwalten_Click"/>
                        <MenuItem Header="Equipment…" Click="EquipmentsVerwalten_Click"/>
                        <MenuItem Header="Wartungen und Alarme…" Click="WartungenVerwalten_Click"/>
                        <MenuItem Header="Trainingsbereiche…" Click="TrainingsbereicheVerwalten_Click"/>
                        <MenuItem Header="Tätigkeiten…" Click="TaetigkeitenVerwalten_Click"/>
                        <MenuItem Header="Saisonziele…" Click="SaisonzieleVerwalten_Click"/>
                        <MenuItem Header="Persönliche Daten…" Click="ProfilBearbeiten_Click"/>
                    </MenuItem>
                    <MenuItem Header="Garmin Connect" Padding="10,6">
                        <MenuItem Header="Downloadaufträge…" Click="GarminImport_Click"/>
                        <MenuItem Header="Garmin Connect – Einstellungen…" Click="GarminEinstellungen_Click"/>
                    </MenuItem>
                </Menu>
            </StackPanel>
            <TextBlock Text="AndyTours" FontSize="26" FontWeight="Bold" Foreground="#18324F"/>
        </DockPanel>
        <Border Grid.Row="1" Background="#E8F1FB" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <TextBlock Text="API_FIRST – Migrationsansicht; weitere Funktionen werden übernommen"
                       Foreground="#245B91" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>
        <WrapPanel Grid.Row="2" Margin="0,0,0,16" IsEnabled="{Binding FilterControlsEnabled}">
            <StackPanel Width="160" Margin="0,0,12,8"><TextBlock Text="Von" Foreground="#637083"/><DatePicker SelectedDate="{Binding VonDatum, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Width="160" Margin="0,0,12,8"><TextBlock Text="Bis" Foreground="#637083"/><DatePicker SelectedDate="{Binding BisDatum, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Width="155" Margin="0,0,12,8"><TextBlock Text="Gruppierung" Foreground="#637083"/><ComboBox ItemsSource="{Binding RasterOptionen}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Raster}" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Width="155" Margin="0,0,12,8"><TextBlock Text="Kennzahl" Foreground="#637083"/><ComboBox ItemsSource="{Binding KennzahlOptionen}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Kennzahl}" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Width="170" Margin="0,0,12,8"><TextBlock Text="Aktivität" Foreground="#637083"/><ComboBox ItemsSource="{Binding AktivitaetsOptionen}" DisplayMemberPath="Name" SelectedItem="{Binding AktivitaetAuswahl, Mode=TwoWay}" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Width="170" Margin="0,0,12,8"><TextBlock Text="Kategorie" Foreground="#637083"/><ComboBox ItemsSource="{Binding KategorieOptionen}" DisplayMemberPath="Name" SelectedItem="{Binding KategorieAuswahl, Mode=TwoWay}" Margin="0,5,0,0"/></StackPanel>
            <Button Content="Aktualisieren" Command="{Binding AktualisierenCommand}" Padding="18,8" VerticalAlignment="Bottom" Margin="0,0,0,8" Background="#246DB2" Foreground="White" FontWeight="SemiBold"/>
        </WrapPanel>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="Distanz" Foreground="#637083"/><TextBlock Text="{Binding DistanzKmText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="Höhenmeter" Foreground="#637083"/><TextBlock Text="{Binding HoehenmeterText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="Fahrzeit" Foreground="#637083"/><TextBlock Text="{Binding FahrzeitText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                <Border Background="White" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="Touren" Foreground="#637083"/><TextBlock Text="{Binding AnzahlText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
            </UniformGrid>
            <TabControl Grid.Row="1" Background="White">
                <TabItem Header="Übersicht">
                    <Grid Margin="16">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <oxy:PlotView Model="{Binding Diagramm}" MinHeight="250"/>
                        <TextBlock Grid.Row="1" Text="{Binding SaisonText, Mode=OneWay}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <TextBlock Grid.Row="2" Text="{Binding ZukunftsHinweis}" Foreground="#875A12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Bestleistungen">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
                        <TextBlock Text="Jahresrekorde" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListView ItemsSource="{Binding Jahresrekorde}" MaxHeight="220" Margin="0,0,0,16"><ListView.View><GridView><GridViewColumn Header="Bezeichnung" DisplayMemberBinding="{Binding Bezeichnung}" Width="260"/><GridViewColumn Header="Wert" DisplayMemberBinding="{Binding Wert}" Width="180"/><GridViewColumn Header="Herkunft" DisplayMemberBinding="{Binding Herkunft}" Width="220"/><GridViewColumn Header="Tour" Width="120"><GridViewColumn.CellTemplate><DataTemplate><Button Content="Tour öffnen…" Click="RekordTourOeffnen_Click"><Button.Style><Style TargetType="Button"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding TourId}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn></GridView></ListView.View></ListView>
                        <TextBlock Text="Einzelrekorde" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListView ItemsSource="{Binding Einzelrekorde}" MaxHeight="260" Margin="0,0,0,8"><ListView.View><GridView><GridViewColumn Header="Bezeichnung" DisplayMemberBinding="{Binding Bezeichnung}" Width="260"/><GridViewColumn Header="Wert" DisplayMemberBinding="{Binding Wert}" Width="180"/><GridViewColumn Header="Herkunft" DisplayMemberBinding="{Binding Herkunft}" Width="260"/><GridViewColumn Header="Tour" Width="120"><GridViewColumn.CellTemplate><DataTemplate><Button Content="Tour öffnen…" Click="RekordTourOeffnen_Click"><Button.Style><Style TargetType="Button"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding TourId}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn></GridView></ListView.View></ListView>
                        <TextBlock Text="Rekordwerte verwenden ausschließlich den gewählten Zeitraum; Teilauswahlen eines Jahres sind keine vollständigen Jahresrekorde." TextWrapping="Wrap" Foreground="#637083" Margin="0,0,0,8" />
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Jahresziele">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
                        <TextBlock Text="Jahresziele – Referenz für das ganze Kalenderjahr" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListView ItemsSource="{Binding Jahresziele}"><ListView.View><GridView><GridViewColumn Header="Jahr" DisplayMemberBinding="{Binding Jahr}" Width="120"/><GridViewColumn Header="Kilometer" DisplayMemberBinding="{Binding ZielKm}" Width="180"/><GridViewColumn Header="Höhenmeter" DisplayMemberBinding="{Binding ZielHm}" Width="180"/><GridViewColumn Header="Anzahl" DisplayMemberBinding="{Binding ZielAnzahl}" Width="160"/></GridView></ListView.View></ListView>
                        <TextBlock Text="Volles Kalenderjahr, nicht auf den gewählten Zeitraum umgerechnet; Kategorien ändern das Aktivitätsziel nicht. Für Fahrzeit gibt es kein Ziel." TextWrapping="Wrap" Foreground="#637083" Margin="0,10,0,0" />
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Pulsbereiche">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="240"/>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Filter oben gelten auch für die Pulsanalyse. Garmin wird nur über den ausdrücklichen Abruf-Button kontaktiert." TextWrapping="Wrap" Foreground="#46566A" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="{Binding PulsReferenzText}" TextWrapping="Wrap" Foreground="#46566A" Margin="0,0,0,8"/>
                        <WrapPanel Grid.Row="2" IsEnabled="{Binding FilterControlsEnabled}" Margin="0,0,0,8">
                            <ComboBox Width="190" Margin="0,0,8,8" ItemsSource="{Binding Pulsprofile}"
                                      SelectedItem="{Binding Pulsprofil, Mode=TwoWay}" DisplayMemberPath="Sport"/>
                            <CheckBox Content="10-bpm-Bereiche statt Garmin-Zonen" IsChecked="{Binding BpmBereiche, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <Button Content="Gespeicherte Referenz laden" Command="{Binding PulsreferenzLadenCommand}" Padding="10,5" Margin="0,0,8,8"/>
                            <Button Content="Aktuelle Garmin-Referenz abrufen…" Command="{Binding GarminZonenAktualisierenCommand}"
                                    Padding="10,5" Margin="0,0,8,8" ToolTip="Ruft Garmin nur auf ausdrücklichen Klick ab."/>
                            <Button Content="Pulsanalyse laden" Command="{Binding PulsdatenLadenCommand}" Padding="10,5" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <oxy:PlotView Grid.Row="3" Model="{Binding PulsDiagramm}" MinHeight="180" Margin="0,0,0,8"/>
                        <DataGrid Grid.Row="4" ItemsSource="{Binding Pulszeilen, Mode=OneWay}" IsReadOnly="True"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True" MinHeight="140" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Zeitraum" Binding="{Binding Zeitraum, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="Zone" Binding="{Binding Zone, Mode=OneWay}" Width="120"/>
                                <DataGridTextColumn Header="Pulsbereich" Binding="{Binding Pulsbereich, Mode=OneWay}" Width="150"/>
                                <DataGridTextColumn Header="Messzeit" Binding="{Binding Messzeit, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="Anteil" Binding="{Binding Anteil, Mode=OneWay}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="5" Text="{Binding PulsStatus}" TextWrapping="Wrap" Foreground="#46566A" Margin="0,8,0,0"/>
                    </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Touren">
                    <DockPanel Margin="12">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" IsEnabled="{Binding FilterControlsEnabled}">
                            <TextBlock Text="Nur Tourentabelle – Kennzahlen und Rekorde bleiben unverändert." Foreground="#637083" Margin="0,0,0,6"/>
                            <WrapPanel>
                                <StackPanel Width="165" Margin="0,0,8,6"><TextBlock Text="Equipment"/><ComboBox ItemsSource="{Binding Tabellenfilter.Equipments}" DisplayMemberPath="Name" SelectedItem="{Binding Tabellenfilter.AusgewaehltesEquipment, Mode=TwoWay}" IsSynchronizedWithCurrentItem="False"/></StackPanel>
                                <StackPanel Width="165" Margin="0,0,8,6"><TextBlock Text="Trainingsbereich"/><ComboBox ItemsSource="{Binding Tabellenfilter.Trainingsbereiche}" DisplayMemberPath="Name" SelectedItem="{Binding Tabellenfilter.AusgewaehlterBereich, Mode=TwoWay}" IsSynchronizedWithCurrentItem="False"/></StackPanel>
                                <StackPanel Width="90" Margin="0,0,8,6"><TextBlock Text="km von"/><TextBox Text="{Binding Tabellenfilter.DistanzVon, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterRangeError}" Tag="{Binding Tabellenfilter.DistanzVonFehlerhaft}"/></StackPanel>
                                <StackPanel Width="90" Margin="0,0,8,6"><TextBlock Text="km bis"/><TextBox Text="{Binding Tabellenfilter.DistanzBis, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterRangeError}" Tag="{Binding Tabellenfilter.DistanzBisFehlerhaft}"/></StackPanel>
                                <StackPanel Width="90" Margin="0,0,8,6"><TextBlock Text="hm von"/><TextBox Text="{Binding Tabellenfilter.HoehenmeterVon, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterRangeError}" Tag="{Binding Tabellenfilter.HoehenmeterVonFehlerhaft}"/></StackPanel>
                                <StackPanel Width="90" Margin="0,0,8,6"><TextBlock Text="hm bis"/><TextBox Text="{Binding Tabellenfilter.HoehenmeterBis, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterRangeError}" Tag="{Binding Tabellenfilter.HoehenmeterBisFehlerhaft}"/></StackPanel>
                                <StackPanel Width="180" Margin="0,0,8,6"><TextBlock Text="Suche"/><TextBox Text="{Binding Tabellenfilter.Suchbegriff, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <Button Content="Filter zurücksetzen" Command="{Binding Tabellenfilter.ResetZuruecksetzenCommand}" Margin="0,0,8,6" VerticalAlignment="Bottom"/>
                                <Button Content="Anwenden" Command="{Binding AktualisierenCommand}" Margin="0,0,8,6" VerticalAlignment="Bottom"/>
                            </WrapPanel>
                            <TextBlock Text="Ungültige Zahlenbereiche sind nach Core-Regel inaktiv." Foreground="#875A12"/>
                        </StackPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10"><TextBlock Text="Ausgewählte Zeilen (diese Seite):" VerticalAlignment="Center"/><TextBlock Text="{Binding AuswahlAnzahl, Mode=OneWay}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                            <Button Content="Neue Tour" Command="{Binding NeueTourCommand}" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="Bearbeiten" Command="{Binding TourBearbeitenCommand}" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="Kopieren" Command="{Binding TourKopierenCommand}" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="Kategorien ändern…" Click="KategorienMehrfach_Click" IsEnabled="{Binding HatTourenauswahl}" Padding="12,6"/><Button Content="Aktivität ändern…" Click="AktivitaetMehrfach_Click" IsEnabled="{Binding HatTourenauswahl}" Padding="12,6"/><Button Content="Equipment ändern…" Click="EquipmentMehrfach_Click" IsEnabled="{Binding HatTourenauswahl}" Padding="12,6"/><Button Content="Auswahl löschen…" Click="LoeschenMehrfach_Click" IsEnabled="{Binding HatTourenauswahl}" Padding="12,6"/>
                            <Button Content="Tourdetails…" Click="TourdetailOeffnen_Click" ToolTip="Mehrere ausgewählte Touren werden als Etappen geöffnet." Padding="12,6" Margin="8,0,0,0"/>
                        </WrapPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="← Vorherige" Command="{Binding VorherigeSeiteCommand}" Padding="12,6" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SeitenText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="Nächste →" Command="{Binding NaechsteSeiteCommand}" Padding="12,6"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding TabellensummeText, Mode=OneWay}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold"/>
                        <DataGrid x:Name="TourenDataGrid" ItemsSource="{Binding Touren}"
                                  SelectedItem="{Binding AusgewaehlteTour, Mode=TwoWay}"
                                  MouseDoubleClick="TourenDataGrid_MouseDoubleClick"
                                  SelectionChanged="TourenDataGrid_SelectionChanged"
                                  Sorting="TourenDataGrid_Sorting" PreviewKeyDown="TourenDataGrid_PreviewKeyDownMehrfach" CanUserSortColumns="True"
                                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True" HorizontalScrollBarVisibility="Auto" GridLinesVisibility="Horizontal">
                            <DataGrid.InputBindings>
                                <KeyBinding Key="F2" Command="{Binding TourBearbeitenCommand}"/>
                                <KeyBinding Key="Enter" Command="{Binding TourBearbeitenCommand}"/>
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Datum" SortMemberPath="Anzeige.Datum" SortDirection="Descending" Binding="{Binding Anzeige.Datum, Mode=OneWay, StringFormat='ddd, dd.MM.yyyy'}" Width="130"/>
                                <DataGridTextColumn Header="Start" SortMemberPath="Anzeige.Startzeit" Binding="{Binding Anzeige.Startzeit, StringFormat={}{0:HH:mm}, Mode=OneWay}" Width="85"/>
                                <DataGridTextColumn Header="Name" SortMemberPath="Anzeige.Name" Binding="{Binding Anzeige.Name, Mode=OneWay}" Width="180"/>
                                <DataGridTextColumn Header="Aktivität" SortMemberPath="Anzeige.Aktivitaet" Binding="{Binding Anzeige.Aktivitaet, Mode=OneWay}" Width="125"/>
                                <DataGridTextColumn Header="Kategorien" SortMemberPath="Anzeige.Kategorien" Binding="{Binding Anzeige.Kategorien, Mode=OneWay}" Width="150"/>
                                <DataGridTextColumn Header="Equipment" SortMemberPath="Anzeige.Equipment" Binding="{Binding Anzeige.Equipment, Mode=OneWay}" Width="145"/>
                                <DataGridTextColumn Header="km" SortMemberPath="Anzeige.DistanzKm" Binding="{Binding Anzeige.DistanzKm, StringFormat={}{0:N2}, Mode=OneWay}" ElementStyle="{StaticResource TourBestDistance}" Width="90"/>
                                <DataGridTextColumn Header="hm" SortMemberPath="Anzeige.Hoehenmeter" Binding="{Binding Anzeige.Hoehenmeter, StringFormat={}{0:N0}, Mode=OneWay}" ElementStyle="{StaticResource TourBestHeight}" Width="80"/>
                                <DataGridTextColumn Header="Fahrzeit" SortMemberPath="Anzeige.FahrzeitSekunden" Binding="{Binding Anzeige.FahrzeitSekunden, Converter={StaticResource DauerConverter}, Mode=OneWay}" ElementStyle="{StaticResource TourBestDuration}" Width="105"/>
                                <DataGridTextColumn Header="Ø km/h" SortMemberPath="Anzeige.DurchschnittKmh" Binding="{Binding Anzeige.DurchschnittKmh, StringFormat={}{0:N1}, Mode=OneWay}" ElementStyle="{StaticResource TourBestAverageSpeed}" Width="85"/>
                                <DataGridTextColumn Header="max km/h" SortMemberPath="Anzeige.MaxKmh" Binding="{Binding Anzeige.MaxKmh, StringFormat={}{0:N1}, Mode=OneWay}" ElementStyle="{StaticResource TourBestMaxSpeed}" Width="85"/>
                                <DataGridTextColumn Header="Ø Puls" SortMemberPath="Anzeige.HfDurchschnitt" Binding="{Binding Anzeige.HfDurchschnitt, StringFormat={}{0:N0}, Mode=OneWay}" Width="75" ElementStyle="{StaticResource TourNumber}"/>
                                <DataGridTextColumn Header="max Puls" SortMemberPath="Anzeige.HfMax" Binding="{Binding Anzeige.HfMax, StringFormat={}{0:N0}, Mode=OneWay}" Width="75" ElementStyle="{StaticResource TourNumber}"/>
                                <DataGridTextColumn Header="Trittfrequenz" SortMemberPath="Anzeige.Trittfrequenz" Binding="{Binding Anzeige.Trittfrequenz, StringFormat={}{0:N0}, Mode=OneWay}" Width="105" ElementStyle="{StaticResource TourNumber}"/>
                                <DataGridTextColumn Header="°C" SortMemberPath="Anzeige.Temperatur" Binding="{Binding Anzeige.Temperatur, StringFormat={}{0:N0}, Mode=OneWay}" Width="65" ElementStyle="{StaticResource TourNumber}"/>
                                <DataGridTextColumn Header="max Höhe" SortMemberPath="Anzeige.MaxHoehe" Binding="{Binding Anzeige.MaxHoehe, StringFormat={}{0:N0}, Mode=OneWay}" Width="90" ElementStyle="{StaticResource TourNumber}"/>
                                <DataGridTextColumn Header="Bereich" SortMemberPath="Anzeige.Trainingsbereich" Binding="{Binding Anzeige.Trainingsbereich, Mode=OneWay}" Width="95"/>
                                <DataGridTextColumn Header="Kommentar" SortMemberPath="Anzeige.Kommentar" Binding="{Binding Anzeige.Kommentar, Mode=OneWay}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <ProgressBar Height="3" IsIndeterminate="{Binding Laedt}" Visibility="{Binding Laedt, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Text="{Binding StatusText}" Foreground="#46566A" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </Grid>
</Window>